---
type Props = {
  href: string;
  variant?: "primary" | "ghost" | "invert";
  /** Offer the target as a file download (e.g. the résumé PDF). */
  download?: boolean;
  class?: string;
};
const { href, variant = "primary", download = false, class: className = "" } = Astro.props;

const external = href.startsWith("http");
---

<a
  href={href}
  class={`btn btn-${variant} group ${className}`}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  download={download || undefined}
>
  <slot />
  <span aria-hidden="true" class="btn-arrow">{download ? "↓" : "→"}</span>
</a>
